# Copia este archivo a .env y completa los valores. Nunca subas .env al repositorio.
# En produccion agrega ?sslmode=require (o verify-full) para cifrar la conexion.
DATABASE_URL=
# Solo si usas la base de datos incluida en docker-compose.yml.
POSTGRES_PASSWORD=
PORT=3000
# production exige https en CRM_WEBHOOK_URL. Usa development solo en tu computador.
NODE_ENV=production
# Cuantos proxies o balanceadores hay delante de Radika (0 si ninguno).
TRUST_PROXY_HOPS=0
# Una o varias llaves separadas por coma, minimo 32 caracteres cada una. El CRM envia una en el encabezado X-Api-Key.
RADIKA_API_KEYS=
# Opcional: direccion del CRM que recibe los avisos, y secreto para firmarlos (minimo 32 caracteres).
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=
# Consulta de Procesos de la Rama Judicial.
RAMA_BASE_URL=https://consultaprocesos.ramajudicial.gov.co:448/api/v2
RAMA_MIN_INTERVAL_MS=1500
RAMA_TIMEOUT_MS=20000
# Cada cuantas horas se revisa cada tramite y cuantos por tanda.
REVISION_INTERVALO_HORAS=4
REVISION_LOTE=10
SCHEDULER_ENABLED=true
# Como se identifica Radika ante las fuentes (pon un correo de contacto real).
CONTACTO_USER_AGENT=Radika/0.1 (contacto: pendiente)
# Opcional: llave de la API de Anthropic para redactar el resumen de cada actuacion nueva.
# Sin llave, Radika funciona igual y los avisos salen sin resumen.
ANTHROPIC_API_KEY=
RESUMEN_IA_MODELO=claude-opus-5-5
# Maximo de resumenes por revision de un tramite (0 los apaga).
RESUMENES_POR_REVISION=10
# Dominios desde los que se aceptan correos de despachos judiciales (incluye subdominios).
CORREO_DOMINIOS_CONFIABLES=ramajudicial.gov.co,notificacionesrj.gov.co,consejodeestado.gov.co,corteconstitucional.gov.co
# Buzon donde llegan las notificaciones de los juzgados. Sin estos datos el lector queda apagado.
# Usa una contrasena exclusiva para Radika y guardala como secreto del servidor.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
# Carpetas a vigilar, separadas por coma. Vacio = todas menos enviados, borradores, papelera y spam.
IMAP_CARPETAS=
# Llave para cifrar los usuarios y claves de los portales. Generala con: openssl rand -base64 32
# Guardala como secreto y haz copia aparte: sin ella las credenciales guardadas no se pueden leer.
CREDENCIALES_LLAVE=
# Cada cuantas horas se revisa un tramite en un portal con inicio de sesion.
PORTAL_INTERVALO_HORAS=24
# Solo al cambiar CREDENCIALES_LLAVE: pon aqui la(s) anterior(es), separadas por coma, hasta que
# todas las credenciales se hayan vuelto a guardar con la nueva.
CREDENCIALES_LLAVES_ANTERIORES=

# Almacen privado de documentos: bucket de S3 (produccion) o carpeta local (desarrollo). Vacios = visor apagado.
DOCUMENTOS_BUCKET=
DOCUMENTOS_DIR=
# Al ver una carpeta del buzon por primera vez, cuantos dias hacia atras procesar (0 = solo lo nuevo).
IMAP_HISTORIAL_DIAS=0
